# Gretta AI — Environment Secrets & Configuration Template
# Copy this file to .env before running locally or add these keys to your Cloud Provider environment variables.

# ==============================================================================
# REQUIRED CREDENTIALS
# ==============================================================================

# Telegram Bot Token obtained from @BotFather (https://t.me/BotFather)
TELEGRAM_TOKEN=123456789:AAA-your-telegram-bot-token-here

# OpenRouter API Key obtained from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# ==============================================================================
# OPTIONAL CONFIGURATIONS
# ==============================================================================

# LLM Model ID on OpenRouter (default: nvidia/nemotron-3-ultra-550b-a55b:free)
MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Dashboard Public Base URL (e.g. https://your-app.vercel.app)
# Used by Telegram Bot inline buttons. MUST be public HTTP/HTTPS URL (Telegram rejects localhost or private IPs).
DASHBOARD_URL=https://your-app.vercel.app

# Custom SQLite Database Path (default: crm.db, use /tmp/crm.db for serverless/read-only systems)
DB_PATH=crm.db

# HTTP Port for Dashboard / Health Check (default: 8000 for dashboard, 7860 for HF Spaces)
PORT=8000
