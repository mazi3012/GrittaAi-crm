# Gretta AI — Environment Secrets & Configuration Template
# Copy this file to .env before running locally or add these keys to your Cloud Provider environment variables.

# ==============================================================================
# REQUIRED CREDENTIALS
# ==============================================================================

# Telegram Bot Token obtained from @BotFather (https://t.me/BotFather)
TELEGRAM_TOKEN=123456789:AAA-your-telegram-bot-token-here

# OpenRouter API Key obtained from https://openrouter.ai/keys (optional when using Groq only)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Groq fallback for text and vision requests
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=qwen/qwen3.6-27b

# ==============================================================================
# OPTIONAL CONFIGURATIONS
# ==============================================================================

# LLM & Vision Model ID on OpenRouter (default: stealth/ox-alpha)
MODEL=stealth/ox-alpha
VISION_MODEL=stealth/ox-alpha
# Optional dashboard Assistant model override. Falls back to MODEL.
ASSISTANT_MODEL=stealth/ox-alpha

# Dashboard Public Base URL (e.g. https://your-app.vercel.app)
# Used by Telegram Bot inline buttons. MUST be public HTTP/HTTPS URL (Telegram rejects localhost or private IPs).
DASHBOARD_URL=https://your-app.vercel.app

# Custom SQLite Database Path (default: crm.db, use /tmp/crm.db for serverless/read-only systems)
DB_PATH=crm.db

# Neon Postgres connection string (shared DB for Render bot + Vercel dashboard).
# When set, it takes priority over SQLite. Get yours from https://console.neon.tech
# (Project -> Connection Details). Keep sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# HTTP Port for Dashboard / Health Check (default: 8000 for dashboard, 7860 for HF Spaces)
PORT=8000

# ==============================================================================
# NEON AUTH (invite-only dashboard access)
# ==============================================================================
# Neon project: bitter-fire-34781865 / branch: production.
# Copy the Auth base URL from Neon Console -> Branch -> Auth -> Configuration.
NEON_AUTH_BASE_URL=https://your-neonauth-host/neondb/auth
# Comma-separated work emails permitted to access this CRM. Keep this list in
# Vercel/Render secrets; leave empty only if Neon user provisioning is the sole gate.
GRITTA_AUTH_INVITED_EMAILS=owner@example.com,teammate@example.com
# true in HTTPS production; false only for local HTTP development.
AUTH_COOKIE_SECURE=true

# ==============================================================================
# TELEGRAM BOT ACCESS CONTROL (private-bot mode)
# ==============================================================================

# Comma-separated Telegram numeric IDs that may always use the bot.
# When BOTH allow-lists are empty the bot is OPEN to anyone (but every user
# is still logged into the bot_users table — see the 🛡 Bot Access tab).
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Comma-separated Telegram @usernames that may always use the bot.
ALLOWED_TELEGRAM_USERNAMES=@your_handle,@teammate_handle

# ==============================================================================
# GOOGLE SHEETS BACKUP (live mirror of the leads table for the team)
# ==============================================================================

# Public /exec URL of the Apps Script Web App deployed inside your team's
# Google Sheet (see google-apps-script.gs + README "Google Sheets backup").
# Leave empty to disable syncing entirely.
GOOGLE_SHEET_WEBAPP_URL=

# Shared secret embedded in every sync request; MUST match the SECRET constant
# inside the Apps Script. Any long random string works.
GOOGLE_SHEET_SECRET=
